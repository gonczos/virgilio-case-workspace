{
  "name": "virgilio-case-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Consultation and enrichment workspace for the Virgilio court-case corpus.",
  "scripts": {
    "import:package": "node ./app/import-package.mjs",
    "start:gateway": "node ./app/file-gateway.mjs",
    "start:consultation": "node ./app/consultation-api.mjs",
    "start:mcp:text-consultation": "node ./app/text-consultation-mcp-server.mjs",
    "start:mcp:text-consultation:http": "node ./app/text-consultation-mcp-http-server.mjs",
    "start:ui": "npm --prefix ./ui run dev",
    "build:ui": "npm --prefix ./ui run build",
    "release:v1:inventory": "node ./app/release-v1-inventory.mjs generate",
    "release:v1:verify": "node ./app/release-v1-inventory.mjs verify",
    "release:v1:contracts": "node ./app/release-v1-contract-fixtures.mjs",
    "test:c4.2": "npm --prefix ./ui run test",
    "spike:c2": "node ./app/phase-c2-spike.mjs",
    "test:c2": "node --test ./test/phase-c2.test.mjs",
    "process:c3:worker": "node ./app/processing-worker.mjs",
    "process:c3:admin": "node ./app/processing-admin.mjs",
    "rollout:c5.3.2": "node ./app/phase-c5.3.2-rollout.mjs",
    "test:c3": "node --test --test-concurrency=1 ./test/phase-c3.test.mjs",
    "test:c3.2": "node --test ./test/file-gateway.test.mjs",
    "test:c4.1": "node --test --test-concurrency=1 ./test/consultation-api.test.mjs",
    "test:c5.2": "node --test ./test/phase-c5.2.test.mjs",
    "test:c5.3.1": "node --test --test-concurrency=1 ./test/phase-c5.3.1.test.mjs",
    "db:migrate:reference-search": "node ./app/apply-reference-search-migration.mjs",
    "reference:index:pilot": "node ./app/reference-index-pilot.mjs seed",
    "reference:lookup": "node ./app/reference-index-pilot.mjs lookup",
    "reference:inventory": "node ./app/reference-metadata-inventory.mjs",
    "reference:evaluate-foundation": "node ./app/evaluate-reference-extraction-foundation.mjs",
    "reference:select-expansion": "node ./app/build-reference-expansion-selection.mjs",
    "reference:index:metadata": "node ./app/reference-metadata-ingestion.mjs",
    "reference:index:v5-fixtures": "node ./app/reference-v5-ingestion.mjs",
    "reference:inventory:v5-corpus": "node ./app/reference-v5-corpus-inventory.mjs",
    "reference:sample:v5-corpus-audit": "node ./app/build-reference-v5-corpus-audit-sample.mjs",
    "reference:build-v6-oracle": "node ./app/build-reference-v6-audit-oracle.mjs",
    "reference:evaluate-v6": "node ./app/evaluate-reference-v6.mjs",
    "reference:save-v5-api-samples": "node ./app/save-reference-v5-ingestion-api-samples.mjs",
    "search:pilot": "node ./app/reference-index-pilot.mjs search",
    "search:evaluate-full": "node ./app/evaluate-full-corpus-text-search.mjs",
    "test:reference-search": "node --test ./test/reference-search-store.test.mjs",
    "test:mcp:text-consultation": "node --test ./test/text-consultation-mcp-tools.test.mjs ./test/text-consultation-mcp-server.test.mjs ./test/text-consultation-mcp-http-server.test.mjs",
    "reference:validate-expansion-text": "node ./app/validate-reference-expansion-text-fixture.mjs",
    "reference:build-expansion-metadata-review": "node ./app/build-reviewed-reference-expansion-metadata-fixture.mjs",
    "reference:validate-expansion-metadata": "node ./app/validate-reference-expansion-metadata-fixture.mjs",
    "reference:evaluate-expansion-text": "node ./app/evaluate-reference-extraction-expansion.mjs",
    "reference:build-expansion-metadata-v2": "node ./app/build-reference-expansion-metadata-v2.mjs",
    "reference:validate-expansion-metadata-v2": "node ./app/validate-reference-expansion-metadata-v2.mjs",
    "reference:evaluate-expansion-metadata-v2": "node ./app/evaluate-reference-expansion-metadata-v2.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "pg": "^8.16.3"
  }
}
