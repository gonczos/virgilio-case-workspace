{
  "clientId": "consultation-chatgpt",
  "name": "Virgilio Consultation - ChatGPT",
  "protocol": "openid-connect",
  "enabled": true,
  "clientAuthenticatorType": "client-secret",
  "publicClient": false,
  "standardFlowEnabled": true,
  "implicitFlowEnabled": false,
  "directAccessGrantsEnabled": false,
  "serviceAccountsEnabled": false,
  "consentRequired": true,
  "fullScopeAllowed": false,
  "redirectUris": ["https://chatgpt.com/connector_platform_oauth_redirect"],
  "webOrigins": [],
  "attributes": {
    "pkce.code.challenge.method": "S256",
    "client.offline.session.idle.timeout": "1800",
    "client.offline.session.max.lifespan": "28800"
  },
  "defaultClientScopes": ["consultation.read", "consultation-mcp-audience"],
  "optionalClientScopes": ["offline_access"]
}
