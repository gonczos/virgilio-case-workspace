FROM node:24.19.0-bookworm-slim AS build
WORKDIR /build
COPY ui/package.json ui/package-lock.json ./
RUN npm ci --ignore-scripts
COPY ui/ ./
ENV VITE_CONSULTATION_V1=true
RUN npm run build

FROM nginx:1.28.3-alpine
COPY deploy/consultation-v1/nginx-main.conf /etc/nginx/nginx.conf
COPY deploy/consultation-v1/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /build/dist/ /usr/share/nginx/html/
